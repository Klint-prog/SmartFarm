#!/bin/sh
set -e

# Allow git commands inside bind-mounted repository paths.
git config --global --add safe.directory /var/www || true

# Ensure writable runtime directories for the web user.
mkdir -p /var/www/var/cache /var/www/var/logs /var/www/var/sessions
chown www-data:www-data -R /var/www/var/cache /var/www/var/logs /var/www/var/sessions

# Legacy project requires Composer v1-compatible plugin API.
COMPOSER_ALLOW_SUPERUSER=1 composer install --no-interaction

if [ ! -d /tmp ]; then
    mkdir -p /tmp
fi

if [ ! -e /tmp/stdout ]; then
    mkfifo -m 666 /tmp/stdout
fi

cat <> /tmp/stdout 1>&2 &

/usr/bin/supervisord -n -c /etc/supervisor/supervisord.conf
